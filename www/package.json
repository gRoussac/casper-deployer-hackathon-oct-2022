    "@nx/web": "22.5.4",
    "@nx/webpack": "22.5.4",
    "@nx/workspace": "22.5.4",
    "@schematics/angular": "21.1.5",
    "@swc-node/register": "1.12.1",
    "@swc/core": "^1.11.13",
    "@tailwindcss/forms": "^0.5.10",
