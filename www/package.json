{
  "name": "casper-deployer",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "nx",
    "postinstall": "node ./decorate-angular-cli.js",
    "start": "npm run start:dev",
    "start:dev": "nx run-many --target=serve --projects=api,frontend --parallel",
    "start:prod": "nx run-many --target=serve --projects=api,frontend --parallel --configuration=production",
    "build": "nx run-many --target=build --projects=api,frontend --parallel --cloud=false",
    "test": "nx run-many --target=test --all --parallel --cloud=false",
    "serve:api": "node dist/apps/api/main.js",
    "serve": "node dist/server.js & node dist/apps/api/main.js",
    "e2e": "nx run api:serve & nx run frontend-e2e:e2e --skip-nx-cache && killall node",
    "cypress": "cypress open --e2e -b chrome -P apps/frontend-e2e"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.1.5",
    "@angular/common": "21.1.5",
    "@angular/compiler": "21.1.5",
    "@angular/core": "21.1.5",
    "@angular/forms": "21.1.5",
    "@angular/platform-browser": "21.1.5",
    "@angular/platform-browser-dynamic": "21.1.5",
    "@angular/router": "21.1.5",
    "@cypress/code-coverage": "^3.14.0",
    "@nestjs/common": "^11.0.12",
    "@nestjs/core": "^11.0.12",
    "@nestjs/platform-express": "^11.0.12",
    "@nx/angular": "22.5.4",
    "casper-rust-wasm-sdk": "file:../casper-rust-wasm-sdk/pkg",
    "casper-rust-wasm-sdk-nodejs": "file:../casper-rust-wasm-sdk/pkg-nodejs",
    "deployer": "file:../wasm/pkg",
    "highlight.js": "^11.11.1",
    "http-proxy-middleware": "^3.0.3",
    "promise-worker": "^2.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.2",
    "toastr": "^2.1.4",
    "tslib": "^2.8.1",
    "typedjson": "1.8.0",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.1.5",
