    "@angular/platform-browser": "22.0.8",
    "@angular/platform-browser-dynamic": "22.0.8",
    "@angular/router": "22.0.8",
    "@cypress/code-coverage": "^4.0.3",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nx/angular": "23.1.1",
    "casper-rust-wasm-sdk": "file:../casper-rust-wasm-sdk/pkg",
    "casper-rust-wasm-sdk-nodejs": "file:../casper-rust-wasm-sdk/pkg-nodejs",
    "deployer": "file:../wasm/pkg",
    "highlight.js": "^11.11.1",
    "http-proxy-middleware": "^3.0.7",
    "promise-worker": "^2.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.2",
    "toastr": "^2.1.4",
    "tslib": "^2.8.1",
    "typedjson": "1.8.0",
    "zone.js": "0.16.2"
  },
